<Application x:Class="HeartRateMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HeartRateMonitor.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Dark.xaml"/>
                <ResourceDictionary Source="Styles/Base.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 强调色：运行时由 ThemeManager.Apply 覆盖 -->
            <Color x:Key="Color.Accent">#FF6366F1</Color>
            <SolidColorBrush x:Key="Brush.Accent" Color="#FF6366F1"/>
            <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2E6366F1"/>
            <SolidColorBrush x:Key="Brush.AccentDeep" Color="#FF4F46E5"/>
            <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF"/>

            <!-- 转换器 -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:HeartRateToBrushConverter x:Key="HeartRateToBrush"/>
            <conv:HexToBrushConverter x:Key="HexToBrush"/>
            <conv:SignalToOpacityConverter x:Key="SignalToOpacity"/>
            <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
