<Window x:Class="HeartRateMonitor.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="780" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Margin="12" CornerRadius="16"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            Effect="{StaticResource Shadow.Shell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Height="46" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" FontSize="14"
                               Foreground="{DynamicResource Brush.Accent}"/>
                    <TextBlock Text="设置" Style="{StaticResource Text.H2}" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Button.Icon}" ToolTip="关闭"
                        Margin="0,0,8,0" Click="OnCloseClick">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource IconText}" FontSize="13"/>
                </Button>
            </Grid>

            <!-- 主体：左侧导航 + 右侧内容 -->
            <Grid Grid.Row="1" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="12" Padding="6">
                    <ListBox Style="{StaticResource NavList}"
                             ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{Binding IconGeometry}" Width="15" Height="15"
                                          Stretch="Uniform" VerticalAlignment="Center"
                                          Fill="{DynamicResource Brush.TextSecondary}"/>
                                    <TextBlock Text="{Binding Title}" Margin="9,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="1" Margin="12,0,0,0" Background="Transparent">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="4,2,10,2">
                        <ContentControl Content="{Binding SelectedSection.View}" Focusable="False"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 底部操作 -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                    Padding="18,10">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource Button.Link}"
                            Command="{Binding ResetAllCommand}" Content="恢复默认"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Outline}" Content="取消"
                                MinWidth="84" Margin="0,0,8,0" Click="OnCancelClick"/>
                        <Button Style="{StaticResource Button.Primary}" Content="保存并关闭"
                                MinWidth="104" Click="OnSaveClick"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
