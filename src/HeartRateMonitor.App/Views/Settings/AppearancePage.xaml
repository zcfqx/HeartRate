<UserControl x:Class="HeartRateMonitor.App.Views.Settings.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="外观" Style="{StaticResource Text.H1}" Margin="0,0,0,6"/>
        <TextBlock Text="调整主题、强调色与悬浮窗尺寸。改动即时生效，关闭设置时自动保存。"
                   Style="{StaticResource Text.Caption}" Margin="0,0,0,16"/>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="主题" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="浅色主题" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="深色适合夜间与低光环境，浅色适合明亮环境。"
                                   Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                  IsChecked="{Binding IsLightTheme}" VerticalAlignment="Center"/>
                </Grid>

                <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,14"/>

                <TextBlock Text="强调色" Style="{StaticResource Text.Label}" Margin="0,0,0,8"/>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                               Text="{Binding AccentColor}" Style="{StaticResource Text.Caption}"/>
                    <ItemsControl ItemsSource="{Binding AccentPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.Icon}" Width="30" Height="30"
                                        Margin="0,0,6,0" ToolTip="{Binding}"
                                        Command="{Binding DataContext.SetAccentColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Border Width="16" Height="16" CornerRadius="8"
                                            Background="{Binding Converter={StaticResource HexToBrush}}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="悬浮窗" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="不透明度" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                </Grid>
                <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding OverlayOpacity}" Margin="0,0,0,4"/>
                <TextBlock Text="0% 时窗口背景完全透明，只保留文字与图形，适合叠加在桌面或视频上。"
                           Style="{StaticResource Text.Caption}" Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="窗口宽度" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding WindowWidth, StringFormat={}{0:F0} px}"
                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                </Grid>
                <Slider Minimum="280" Maximum="520" SmallChange="10" LargeChange="40"
                        Value="{Binding WindowWidth}" Margin="0,0,0,4"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="极简模式" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="启用极简模式" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="只显示心跳图标与数字；窗口可拖动，双击退出极简模式。"
                                   Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                  IsChecked="{Binding MinimalMode}" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="显示趋势曲线" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="在极简模式的心率数字下方显示最近心率曲线。"
                                   Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                  IsChecked="{Binding MinimalShowChart}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="窗口行为" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="关闭时最小化到托盘" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="关闭按钮只隐藏窗口，后台继续采集心率。" Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                  IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="开机自动启动" Style="{StaticResource Text.Label}"/>
                        <TextBlock Text="登录 Windows 后自动启动心率监控。" Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}"
                                  IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
