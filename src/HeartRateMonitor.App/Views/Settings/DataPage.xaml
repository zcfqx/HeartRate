<UserControl x:Class="HeartRateMonitor.App.Views.Settings.DataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="数据" Style="{StaticResource Text.H1}" Margin="0,0,0,6"/>
        <TextBlock Text="心率数据保存在本地 SQLite 数据库，可设置保留天数并清理旧记录。"
                   Style="{StaticResource Text.Caption}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="保留策略" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="数据保留天数" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                               Text="{Binding DataRetentionDays, StringFormat={}{0:F0} 天}"/>
                </Grid>
                <Slider Minimum="7" Maximum="180" SmallChange="1" LargeChange="30"
                        Value="{Binding DataRetentionDays}" Margin="0,0,0,14"/>
                <Button Content="清理旧数据" Style="{StaticResource Button.Outline}"
                        Command="{Binding CleanupDataCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="存储位置" Style="{StaticResource Text.H2}" Margin="0,0,0,12"/>

                <TextBlock Text="数据目录" Style="{StaticResource Text.Label}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding DataLocation}" Style="{StaticResource Text.Caption}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                <TextBlock Text="日志目录" Style="{StaticResource Text.Label}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding LogLocation}" Style="{StaticResource Text.Caption}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="打开数据目录" Style="{StaticResource Button.Ghost}"
                            Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0"/>
                    <Button Content="打开日志目录" Style="{StaticResource Button.Ghost}"
                            Command="{Binding OpenLogFolderCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
