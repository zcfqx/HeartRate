<UserControl x:Class="HeartRateMonitor.App.Views.Settings.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="关于" Style="{StaticResource Text.H1}" Margin="0,0,0,6"/>
        <TextBlock Text="轻量、插件化的蓝牙心率监控悬浮窗。" Style="{StaticResource Text.Caption}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="&#x2665;" FontFamily="Segoe UI Symbol" FontSize="34"
                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HeartRateMonitor" Style="{StaticResource Text.H2}"/>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Text="{Binding Version, StringFormat=版本 {0}}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding PluginSummary}" Style="{StaticResource Text.Label}"
                           TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                           Text=".NET 8 + WPF，无第三方图表/托盘/日志依赖；核心、数据、服务、插件契约分层，界面完全由插件组件拼装。"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="目录" Style="{StaticResource Text.H2}" Margin="0,0,0,10"/>

                <TextBlock Text="插件目录" Style="{StaticResource Text.Label}" Margin="0,0,0,2"/>
                <TextBlock Text="{Binding PluginsLocation}" Style="{StaticResource Text.Caption}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="打开插件目录" Style="{StaticResource Button.Ghost}"
                            Command="{Binding OpenPluginsFolderCommand}" Margin="0,0,8,0"/>
                    <Button Content="打开数据目录" Style="{StaticResource Button.Ghost}"
                            Command="{Binding OpenDataFolderCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
