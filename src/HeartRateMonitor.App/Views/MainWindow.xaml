<Window x:Class="HeartRateMonitor.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:HeartRateMonitor.Core.Enums;assembly=HeartRateMonitor.Core"
        xmlns:controls="clr-namespace:HeartRateMonitor.App.Controls"
        Title="HeartRateMonitor"
        Width="320" SizeToContent="Height" MaxHeight="780" MinWidth="280"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True">

    <Border x:Name="Shell" Margin="14"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            CornerRadius="18" Effect="{StaticResource Shadow.Shell}">
        <Grid>
            <!-- ===== 普通模式：顶栏 + 组件看板 + 底栏 + 组件库 ===== -->
            <Grid x:Name="NormalView"
                  Visibility="{Binding IsMinimalMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏 -->
                <Grid Grid.Row="0" Height="46" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#x2665;" FontFamily="Segoe UI Symbol" FontSize="17"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Text="心率监控" Style="{StaticResource Text.Label}" FontWeight="SemiBold"
                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                        <Ellipse Width="7" Height="7" Margin="10,0,5,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static core:ConnectionState.Connected}">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static core:ConnectionState.Connecting}">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static core:ConnectionState.Scanning}">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static core:ConnectionState.Reconnecting}">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource Button.Icon}" ToolTip="添加组件"
                                Command="{Binding ToggleAddPanelCommand}">
                            <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource Button.Icon}" ToolTip="编辑看板" Margin="2,0,0,0"
                                Command="{Binding ToggleEditModeCommand}">
                            <Button.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                    <Setter Property="FontSize" Value="14"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                            <TextBlock Text="&#xE70F;"/>
                        </Button>
                        <Button Style="{StaticResource Button.Icon}" ToolTip="极简模式" Margin="2,0,0,0"
                                Command="{Binding ToggleMinimalModeCommand}">
                            <TextBlock Text="&#xE740;" Style="{StaticResource IconText}" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource Button.Icon}" ToolTip="设置" Margin="2,0,0,0"
                                Command="{Binding OpenSettingsCommand}">
                            <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource Button.Icon}" ToolTip="最小化" Margin="2,0,0,0"
                                Click="OnMinimizeClick">
                            <TextBlock Text="&#xE921;" Style="{StaticResource IconText}" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource Button.Icon}" ToolTip="关闭到托盘" Margin="2,0,0,0"
                                Click="OnCloseClick">
                            <TextBlock Text="&#xE8BB;" Style="{StaticResource IconText}" FontSize="14"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 组件看板 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="12,2,12,0">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Tiles}" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Data="{Binding IconGeometry}" Width="14" Height="14"
                                                      Stretch="Uniform" VerticalAlignment="Center"
                                                      Fill="{DynamicResource Brush.Accent}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                           Style="{StaticResource Text.Label}" FontWeight="SemiBold"
                                                           Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PluginName}" Style="{StaticResource Text.Caption}"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <Button ToolTip="移除组件" Width="24" Height="24"
                                                            Command="{Binding DataContext.RemoveWidgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Icon.Danger}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Setter Property="Width" Value="24"/>
                                                                <Setter Property="Height" Value="24"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <ContentPresenter Grid.Row="1" Content="{Binding View}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 空态 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,26"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="还没有组件" Style="{StaticResource Text.Label}" HorizontalAlignment="Center"/>
                            <TextBlock Text="点击右上角 ＋ 从组件库添加" Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- 底栏 -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="本次会话 " Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding SessionDurationText}" Style="{StaticResource Text.Caption}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text=" · " Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Text.Caption}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Link}"
                                Command="{Binding ToggleAddPanelCommand}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="11"/>
                                <TextBlock Text="添加组件" Style="{StaticResource Text.Caption}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 组件库抽屉 -->
                <Grid Grid.RowSpan="3" Background="{DynamicResource Brush.Overlay}"
                      Visibility="{Binding IsAddPanelOpen, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}" Margin="14" Padding="14"
                            VerticalAlignment="Top" MaxHeight="520">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="组件库" Style="{StaticResource Text.H2}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                        ToolTip="关闭" Command="{Binding CloseAddPanelCommand}">
                                    <TextBlock Text="&#xE8BB;" Style="{StaticResource IconText}" FontSize="12"/>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding AvailableWidgets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Button.Ghost}" Margin="0,0,0,6"
                                                            Padding="10,8" HorizontalContentAlignment="Stretch"
                                                            Command="{Binding DataContext.AddWidgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{Binding Icon, Converter={StaticResource IconKeyToGeometry}}"
                                                                  Width="15" Height="15" Stretch="Uniform"
                                                                  VerticalAlignment="Center"
                                                                  Fill="{DynamicResource Brush.Accent}"/>
                                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}"
                                                                           FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Style="{StaticResource Text.Caption}"
                                                                           TextWrapping="Wrap" MaxWidth="220"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="所有组件都可移除，可在设置 → 功能插件中停用或加载更多插件。"
                                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,6,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="组件库已全部添加到看板"
                                               Margin="2,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AvailableWidgets.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== 极简模式：心跳图标 + 数字（可选曲线）===== -->
            <Grid x:Name="MinimalView"
                  Visibility="{Binding IsMinimalMode, Converter={StaticResource BoolToVisibility}}"
                  Background="Transparent"
                  MouseLeftButtonDown="OnMinimalMouseLeftButtonDown">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="显示趋势曲线" IsCheckable="True"
                                  IsChecked="{Binding MinimalShowChart, Mode=OneWay}"
                                  Command="{Binding ToggleMinimalChartCommand}"/>
                        <MenuItem Header="退出极简模式" Command="{Binding ToggleMinimalModeCommand}"/>
                        <Separator/>
                        <MenuItem Header="设置" Command="{Binding OpenSettingsCommand}"/>
                        <MenuItem Header="最小化" Click="OnMinimizeClick"/>
                        <MenuItem Header="关闭" Click="OnCloseClick"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,14,14,12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="MinimalHeart" Text="&#x2665;" FontFamily="Segoe UI Symbol"
                                   FontSize="26" Foreground="{DynamicResource Brush.Accent}"
                                   VerticalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="MinimalHeartScale" CenterX="13" CenterY="13"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentBpm}" Margin="8,0,4,0" VerticalAlignment="Center"
                                   FontSize="44" FontWeight="Bold" Foreground="{DynamicResource Brush.Text}"/>
                        <TextBlock Text="BPM" Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,11"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Center" Margin="0,6,0,0" Padding="8,2" CornerRadius="6"
                            Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="{Binding MinimalZoneName}" FontSize="11"
                                   Foreground="{Binding MinimalZoneColor, Converter={StaticResource HexToBrush}}"/>
                    </Border>

                    <Grid Margin="0,10,0,0" Width="150" Height="40"
                          Visibility="{Binding MinimalShowChart, Converter={StaticResource BoolToVisibility}}">
                        <controls:Sparkline Points="{Binding SessionPoints}"
                                            LineBrush="{DynamicResource Brush.Accent}"
                                            FillBrush="{DynamicResource Brush.AccentSoft}"
                                            MinimumBpm="40" MaximumBpm="200"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
