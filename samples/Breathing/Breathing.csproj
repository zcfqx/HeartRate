<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HeartRateMonitor.Plugin.Breathing</RootNamespace>
    <AssemblyName>HeartRateMonitor.Plugin.Breathing</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HeartRateMonitor.Extensibility\HeartRateMonitor.Extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 构建后把插件整理到独立的 plugin 目录，方便整体复制到插件目录。 -->
  <Target Name="StagePluginDirectory" AfterTargets="Build">
    <PropertyGroup>
      <StageDirectory>$(TargetDir)plugin\</StageDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(StageDirectory)" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)plugin.json" DestinationFolder="$(StageDirectory)" />
  </Target>

</Project>
